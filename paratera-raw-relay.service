[Unit]
Description=Raw Responses relay for Paratera
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=paratera-relay
Group=paratera-relay
EnvironmentFile=/etc/paratera-raw-relay.env
ExecStart=/usr/bin/python3 /opt/paratera-raw-relay/paratera_raw_relay.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
